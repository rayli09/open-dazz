// OpenDazz: the view. data/src/lib.rs answers what it asks for. Colours, fonts,
// sizes and the safe area are left unsaid, so each platform supplies its own:
// the header is the navigation bar, its heading the title.
//
// Placeholder shell for the Exact adoption spike: the recipe list is real
// catalog data; the preview and Export are placeholders. The UI is redesigned
// in a later step.
shape Recipe
  id: string
  name: string

routes nav
  home "/"

component Opendazz
  resource recipes = recipes() as shape Recipe[]
  state selectedName = ""
  state exportNote = ""
  action select(name: string)
    selectedName = name
    exportNote = ""
  action export
    exportNote = "Export is a placeholder: no file is written yet."
  view
    main testId="root" navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationScroll="content" position="absolute" inset=0 display="flex" flex-direction="column"
          header display="flex" align-items="center"
            text "OpenDazz" role="heading" aria-level=1 flex=1
          list id="content" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
            section
              row
                column flex=1 min-width=0 gap=4 background-color="-exact-secondary-background" padding=16 testId="preview"
                  text (selectedName == "" ? "No recipe selected." : `Preview: ${selectedName}`) testId="preview-text"
                  text "Placeholder: no photo is loaded and no look is applied." font="-exact-footnote"
              row
                button press=export buttonStyle="filled" testId="export"
                  text "Export"
              if exportNote != ""
                row
                  text exportNote font="-exact-footnote" testId="export-note"
            section
              header
                text "Recipes" role="heading" aria-level=2
              for r in recipes key=r.id
                row testId=`recipe-${r.id}`
                  button press=select(r.name) testId=`select-${r.id}`
                    text r.name
