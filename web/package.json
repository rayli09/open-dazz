{
  "name": "opendazz-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "dev": "bun --bun vite",
    "typecheck": "bun --bun tsc --noEmit && bun --bun tsc -p tsconfig.wasm.json --noEmit",
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "predev": "bun scripts/sync-library.mjs && bun scripts/sync-ffmpeg.mjs",
    "prebuild": "bun scripts/sync-library.mjs && bun scripts/sync-ffmpeg.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@uppy/core": "^6.3.0",
    "@uppy/drop-target": "^5.0.1",
    "@videojs/html": "10.2.0",
    "heic-to": "^1.6.6",
    "mediabunny": "^1.62.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3"
  }
}
