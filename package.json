{
  "name": "opendazz-workspace",
  "private": true,
  "workspaces": ["web", "apps/desktop"],
  "packageManager": "bun@1.4.3",
  "engines": { "bun": "1.4.3" },
  "scripts": {
    "dev": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "preview": "bun run --cwd web preview",
    "test": "bun run --cwd web test",
    "typecheck": "bun run --cwd web typecheck",
    "desktop:dev": "bun run --cwd apps/desktop dev",
    "desktop:build": "bun run --cwd apps/desktop build"
  }
}
